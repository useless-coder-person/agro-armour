{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agro ARMour advisory card",
  "type": "object",
  "required": ["id", "kind", "key", "crops", "names", "relevance_india", "identify", "damage", "severity", "actions",
               "safety", "region_notes", "season_notes", "stage_notes", "sources"],
  "additionalProperties": false,
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 300},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "chem": {
      "type": "object", "additionalProperties": false,
      "required": ["active", "formulation", "dose", "dose_unit", "water_l_per_ha", "phi_days", "source_id"],
      "properties": {
        "active": {"type": "string", "minLength": 2},
        "formulation": {"type": "string"},
        "dose": {"type": "string", "minLength": 1},
        "dose_unit": {"type": "string", "minLength": 1},
        "water_l_per_ha": {"type": ["number", "null"]},
        "phi_days": {"type": ["number", "null"]},
        "source_id": {"type": "string", "minLength": 1}
      }
    },
    "level": {
      "type": "object", "additionalProperties": false, "required": ["cultural", "biological", "chemical"],
      "properties": {
        "cultural": {"$ref": "#/$defs/texts"},
        "biological": {"$ref": "#/$defs/texts"},
        "chemical": {"type": "array", "items": {"$ref": "#/$defs/chem"}}
      }
    },
    "notes": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "properties": {
    "id": {"type": "string", "pattern": "^(pest|disease|pest_damage)\\.[A-Za-z0-9_]+$"},
    "kind": {"enum": ["pest", "disease", "pest_damage"]},
    "key": {"type": "string", "minLength": 1},
    "also_keys": {"type": "array", "items": {"type": "string"}, "description": "other model labels routed to this card"},
    "crops": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "names": {
      "type": "object", "required": ["en"], "additionalProperties": false,
      "properties": {"en": {"type": "string"}, "scientific": {"type": "string"}}
    },
    "relevance_india": {"enum": ["high", "medium", "low"]},
    "identify": {"type": "array", "items": {"$ref": "#/$defs/text"}, "minItems": 1, "maxItems": 4},
    "damage": {"type": "string"},
    "severity": {
      "type": "object", "additionalProperties": false, "required": ["mode", "thresholds", "source_id"],
      "properties": {
        "mode": {"enum": ["count", "presence_incidence", "lesion_area"]},
        "thresholds": {"type": "object", "additionalProperties": false,
                       "properties": {"low": {"type": "string"}, "medium": {"type": "string"}, "high": {"type": "string"},
                                      "etl": {"type": "string"}}},
        "source_id": {"type": ["string", "null"]}
      }
    },
    "actions": {
      "type": "object", "additionalProperties": false, "required": ["low", "medium", "high"],
      "properties": {"low": {"$ref": "#/$defs/level"}, "medium": {"$ref": "#/$defs/level"}, "high": {"$ref": "#/$defs/level"}}
    },
    "safety": {"$ref": "#/$defs/texts"},
    "region_notes": {"$ref": "#/$defs/notes"},
    "season_notes": {"$ref": "#/$defs/notes"},
    "stage_notes": {"$ref": "#/$defs/notes"},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title", "publisher", "url", "accessed"],
        "properties": {
          "id": {"type": "string"}, "title": {"type": "string"}, "publisher": {"type": "string"},
          "url": {"type": "string", "pattern": "^https?://"},
          "accessed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "local_text": {"type": "string", "description": "text extract under $AGROARMOUR_SOURCES, used by kb_lint to check doses verbatim"}
        }
      }
    }
  }
}
